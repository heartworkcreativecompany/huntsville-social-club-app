# Huntsville Social Club — environment variables
# Copy to `.env.local` for local development.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL (used for Stripe redirect URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (test mode for local development)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe recurring monthly price IDs (map to membership tiers)
# Create prices in Stripe Dashboard: Inner Circle $29.99/mo, Elite Circle $69.99/mo
STRIPE_PRICE_ID_INNER_CIRCLE=price_...
STRIPE_PRICE_ID_ELITE_CIRCLE=price_...

# Optional: one-time $199 event sponsorship price (falls back to inline price_data if unset)
# STRIPE_PRICE_ID_EVENT_SPONSORSHIP=price_...

# Optional: default trial days for new subscriptions via Checkout (omit to disable)
# STRIPE_CHECKOUT_TRIAL_DAYS=14

# Stripe Customer Portal — configure in Stripe Dashboard → Settings → Billing → Customer portal

# Stripe Identity (membership application verification — separate from Checkout subscriptions)
# Enable Identity in Stripe Dashboard, then add these webhook events to the same endpoint:
#   identity.verification_session.verified
#   identity.verification_session.requires_input
#   identity.verification_session.processing
#   identity.verification_session.canceled
# Uses STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET above (no extra Identity-only env vars required).

# Also ensure checkout.session.completed is enabled (membership subscriptions + event sponsorships).
