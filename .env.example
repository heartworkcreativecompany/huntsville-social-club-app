# Huntsville Social Club — environment variables
# Copy to `.env.local` for local development.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public origin (auth emailRedirectTo, Stripe return URLs).
# Local: http://localhost:3000
# Production: https://your-production-domain (never localhost on a deploy)
# Supabase Dashboard → Authentication → URL Configuration:
#   Site URL = same origin as NEXT_PUBLIC_APP_URL
#   Redirect URLs must include: {NEXT_PUBLIC_APP_URL}/auth/callback
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth email confirmation UX hints (optional override):
# - true: show “confirm email” copy even in development
# - false: treat confirmation as optional in app copy
# Login is still gated by your Supabase project’s “Confirm email” setting.
# NEXT_PUBLIC_AUTH_EMAIL_CONFIRMATION_REQUIRED=true

# Supabase Auth confirmation emails (signup / resend) are sent by Supabase —
# configure Authentication → Email / custom SMTP in the Supabase Dashboard.
# They are NOT sent via Resend.
#
# Phone verification (member-facing “Phone verification”) uses Supabase Auth
# phone_change SMS OTP. Configure Authentication → Phone and an SMS provider
# (commonly Twilio) in the Supabase Dashboard. No separate Twilio app keys
# are required in this repo.

# Transactional app email (welcome, approvals, messaging) via Resend
RESEND_API_KEY=
# EMAIL_FROM="Huntsville Social Club <hello@yourdomain.com>"

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
# Production MUST use live-mode keys (sk_live_… / pk_live_…).
# Local development may use test-mode keys (sk_test_… / pk_test_…).
# Member tier is free — only Inner Circle and Elite Circle have Stripe prices.
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Live-mode recurring monthly price IDs (production Stripe account).
# Canonical defaults also live in lib/stripe/config.ts (STRIPE_LIVE_PRICE_IDS).
# Production ignores env overrides and always uses those live IDs.
# For local test-mode only, you may point these at test price IDs instead.
STRIPE_PRICE_ID_INNER_CIRCLE=price_1TqimnBei7W40myBUKESC7wF
STRIPE_PRICE_ID_ELITE_CIRCLE=price_1TqimyBei7W40myBRnke6fQF

# Live-mode one-time $199 event sponsorship price
STRIPE_PRICE_ID_EVENT_SPONSORSHIP=price_1Tw4UjBei7W40myBOG1mkxQ5

# Optional: default trial days for new subscriptions via Checkout (omit to disable)
# STRIPE_CHECKOUT_TRIAL_DAYS=14

# Stripe Customer Portal — configure in Stripe Dashboard → Settings → Billing → Customer portal

# Stripe Identity (membership “Identity & location verification”)
# Enable Identity in Stripe Dashboard, then add these webhook events:
#   identity.verification_session.verified
#   identity.verification_session.requires_input
#   identity.verification_session.processing
#   identity.verification_session.canceled
# Return URL used by the app: {NEXT_PUBLIC_APP_URL}/application/status?identity=return
# Uses STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET above (no extra Identity-only env vars).

# Also ensure checkout.session.completed is enabled (membership subscriptions + event sponsorships).
